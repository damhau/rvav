      },
      "kind": "vm",
      "naming": "{project}-{environment}-tt{component}{seq:02}",
      "rollback_on_failure": true,
      "security_groups": [
        {
          "key": "web",
          "rules": [
            {
              "from": [
                "any"
              ],
              "services": [
                "HTTPS"
              ]
            }
          ],
          "title": "Web"
        },
        {
          "key": "app",
          "rules": [
            {
              "from": [
                "web"
              ],
              "services": [
                "HTTP"
              ]
            }
          ],
          "title": "Application"
        },
        {
          "key": "db",
          "rules": [
            {
              "from": [
                "app"
              ],
              "services": [
                "PostgreSQL"
              ]
            },
            {
              "action": "drop",
              "from": [
                "any"
              ],
              "services": [
                "any"
              ]
            }
          ],
          "title": "Database"
        }
      ],
      "segments": [
        {
          "key": "app",
          "title": "Application"
        }
      ],
      "template": "tpl-rhel9.4-2026.10"
    },
