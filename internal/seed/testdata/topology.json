  {
    "name": "probe-vm-literals",
    "blueprint": {
      "bindings": {
        "groups": "inputs.env == 'prod' ? ['grp-pci'] : []",
        "network": "{'prod':'vlan-pci-secret'}[inputs.env]",
        "post_config": "['linux-baseline', 'idm-join']",
        "template": "\"rhel9-gold\"",
        "vcpu": "4"
      },
      "components": [
        {
          "count": "inputs.tier == 'gold-secret' ? 3 : 1",
          "disks": [
            {
              "datastore": "\"vsan-secret\"",
              "size_gb": "inputs.env == 'prod' ? 500 : 50"
            }
          ],
          "key": "web",
          "nics": [
            {
              "key": "pci",
              "network": "\"dvpg-pci\""
            },
            {
              "key": "b",
              "network": "project.code in ['fin', 'hr'] ? 'vl1' : 'vl2' // the PCI VLANs"
            }
          ]
        }
      ],
      "guest": {
        "admin_password": "hunter2",
        "os_family": "linux"
      },
      "kind": "vm",
      "naming": "{project}-x{seq:02}"
    },
    "topology": {
      "bindings": {
        "groups": "inputs.env == '…' ? ['…'] : []",
        "network": "{'…':'…'}[inputs.env]",
        "post_config": "['linux-baseline', 'idm-join']",
        "template": "\"rhel9-gold\""
      },
      "components": [
        {
          "count": "inputs.tier == '…' ? 3 : 1",
          "disks": [
            {
              "size_gb": "inputs.env == '…' ? 500 : 50"
            }
          ],
          "key": "web",
          "nics": [
            {
              "key": "pci",
              "network": "\"dvpg-pci\""
            },
            {
              "key": "b",
              "network": "project.code in ['…', '…'] ? '…' : '…'"
            }
          ]
        }
      ],
      "guest": {
        "os_family": "linux"
      },
      "kind": "vm"
    }
  },
  {
    "name": "probe-composite-literals",
    "blueprint": {
      "kind": "composite",
      "steps": [
        {
          "item": "rhel9-server",
          "key": "a",
          "when": "inputs.token == 'tok_live_SECRET'",
          "with": {
            "host": "steps.x.fqdn + '.secret'",
            "password": "'hunter2'"
          }
        },
        {
          "parallel": [
            {
              "key": "b",
              "when": "inputs.token == 'open",
              "workflow": "x"
            },
            {
              "awx": {
                "inventory": "inv",
                "job_template": "t",
                "template_id": 4,
                "title": "T"
              },
              "key": "c",
              "undo": {
                "job_template": "u",
                "with": {
                  "k": "'v'"
                }
              },
              "when": "r\"é\\d\" in inputs.tags"
            }
          ]
        }
      ]
    },
    "topology": {
      "kind": "composite",
      "steps": [
        {
          "item": "rhel9-server",
          "key": "a",
          "when": "inputs.token == '…'",
          "with": {
            "host": "steps.x"
          }
        },
        {
          "parallel": [
            {
              "key": "b",
              "when": "…",
              "workflow": "x"
            },
            {
              "awx": {
                "job_template": "t",
                "title": "T"
              },
              "key": "c",
              "undo": {
                "job_template": "u",
                "with": {}
              },
              "when": "r\"…\" in inputs.tags"
            }
          ]
        }
      ]
    }
  },
  {
    "name": "probe-composite-rest",
    "blueprint": {
      "kind": "composite",
      "steps": [
        {
          "key": "cmdb",
          "rest": {
            "accept": [
              201,
              418
            ],
            "body": "{'owner': inputs.owner, 'api_key': 'tok_live_b'}",
            "keep": "$.result_secret",
            "method": "POST",
            "secret": "cmdb-token-name",
            "url": "https://cmdb-secret.corp.example/api/ci/${steps.vm.name}?token=tok_live_q&env=${environment == 'prod' ? 'p-secret' : ''}"
          },
          "title": "CMDB",
          "undo": {
            "rest": {
              "method": "DELETE",
              "secret": "cmdb-token-name",
              "url": "https://cmdb-secret.corp.example/api/ci/${steps.cmdb.json.id}"
            }
          }
        },
        {
          "parallel": [
            {
              "key": "bad",
              "rest": {
                "method": "GET",
                "url": "https://cmdb-secret.corp.example/${'tok_live_open"
              }
            },
            {
              "awx": {
                "job_template": "t"
              },
              "key": "awx",
              "undo": {
                "rest": {
                  "body": "'tok_live_c'",
                  "method": "POST",
                  "url": "https://cmdb-secret.corp.example/undo"
                }
              }
            }
          ]
        }
      ]
    },
    "topology": {
      "kind": "composite",
      "steps": [
        {
