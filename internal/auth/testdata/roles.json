{
  "catalogue": [
    {
      "id": "project.see",
      "scope": "project",
      "area": "Projects",
      "summary": "See the project: its catalog, deployments, requests, members, quotas and reports, as they change."
    },
    {
      "id": "deployments.read_all",
      "scope": "project",
      "area": "Projects",
      "summary": "See every deployment and request of the project, when its deployments show to their owners only."
    },
    {
      "id": "request.submit",
      "scope": "project",
      "area": "Requests",
      "summary": "Request from the project's catalog and save drafts; own deployments there, and move one into it."
    },
    {
      "id": "request.on_behalf",
      "scope": "project",
      "area": "Requests",
      "summary": "Request for someone else."
    },
    {
      "id": "request.manage",
      "scope": "project",
      "area": "Requests",
      "summary": "Cancel, retry and roll back anyone's request in the project."
    },
    {
      "id": "approval.project",
      "scope": "project",
      "area": "Approvals",
      "summary": "Be one of the project's approvers, asked when a lease is extended beyond its policy; held only from a role given in the project."
    },
    {
      "id": "project.members.manage",
      "scope": "project",
      "area": "Projects",
      "summary": "Add and remove the project's members, and change their roles."
    },
    {
      "id": "project.settings.read",
      "scope": "project",
      "area": "Projects",
      "summary": "See the project's administration: its placement, quotas and the policies that apply there; for all of rvav, every project's."
    },
    {
      "id": "project.update",
      "scope": "project",
      "area": "Projects",
      "summary": "Change the project's details and environments, or archive it."
    },
    {
      "id": "project.quotas.manage",
      "scope": "project",
      "area": "Projects",
      "summary": "Set the project's quotas."
    },
    {
      "id": "placement.manage",
      "scope": "project",
      "area": "Projects",
      "summary": "Change the project's placement rules and Active Directory OUs."
    },
    {
      "id": "audit.read",
      "scope": "project",
      "area": "Audit",
      "summary": "Read the audit log: the project's events, or every event for all of rvav."
    },
    {
      "id": "project.policies.manage",
      "scope": "project",
      "area": "Policies",
      "summary": "Write the project's own approval, day-2 and lease policies; a global hard policy still wins."
    },
    {
      "id": "approval.read_all",
      "scope": "rvav",
      "area": "Approvals",
      "summary": "See every approval, and the questions and answers of composites' waits for a person."
    },
    {
      "id": "project.create",
      "scope": "rvav",
      "area": "Projects",
      "summary": "Create projects, and name their first project admins, themselves included."
    },
    {
      "id": "environments.read",
      "scope": "rvav",
      "area": "Projects",
      "summary": "See the environments' settings."
    },
    {
      "id": "environments.manage",
      "scope": "rvav",
      "area": "Projects",
      "summary": "Add, change and remove environments."
    },
    {
      "id": "access.read",
      "scope": "rvav",
      "area": "Access",
      "summary": "See the roles and who holds them, groups of the identity provider included."
    },
    {
      "id": "access.manage",
      "scope": "rvav",
      "area": "Access",
      "summary": "Create roles, and give them to users and groups: whoever holds it can give themselves any permission."
    },
    {
      "id": "catalog.manage",
      "scope": "rvav",
      "area": "Catalog",
      "summary": "Build, publish and open catalog items, with their categories, secrets, shared variables, Git repository and AWX templates; read what their steps were given and gave."
    },
    {
      "id": "infrastructure.read",
      "scope": "rvav",
      "area": "Infrastructure",
      "summary": "See templates, sizes, network mappings, IP ranges and the vCenters rvav reaches."
    },
    {
      "id": "infrastructure.manage",
      "scope": "rvav",
      "area": "Infrastructure",
      "summary": "Change templates, sizes, network mappings and IP ranges, and reconcile IPAM."
    },
    {
      "id": "integrations.manage",
      "scope": "rvav",
      "area": "Integrations",
      "summary": "See, set and test the identity provider and every connection, and create the inventory token and ServiceNow's."
    },
    {
      "id": "policies.read",
      "scope": "rvav",
      "area": "Policies",
      "summary": "See the approval, day-2, lease and naming policies, every project's included."
    },
    {
      "id": "policies.manage",
      "scope": "rvav",
      "area": "Policies",
      "summary": "Change the approval, day-2, lease and naming policies."
    },
    {
      "id": "extensibility.read",
      "scope": "rvav",
      "area": "Extensibility",
      "summary": "See event subscriptions, their runs, the custom workflows and the custom resource types; read the shared variables and what composite steps were given and gave."
    },
    {
      "id": "extensibility.manage",
      "scope": "rvav",
      "area": "Extensibility",
      "summary": "Change event subscriptions, custom workflows, custom resource types, AWX day-2 actions and day-2 forms, retry and test runs."
    },
    {
      "id": "import.manage",
      "scope": "rvav",
      "area": "Import",
      "summary": "Onboard existing VMs and import from vRA."
    },
    {
      "id": "system.manage",
      "scope": "rvav",
      "area": "System",
      "summary": "Use the setup checklist and the System page; set the branding and the notification templates."
    },
    {
      "id": "tokens.manage",
      "scope": "rvav",
      "area": "Access",
      "summary": "See and revoke everyone's API tokens."
    },
    {
      "id": "inventory.read",
      "scope": "rvav",
      "area": "Integrations",
      "summary": "Read the Ansible inventory."
    }
  ],
  "day2_groups": [
    "power",
    "configuration",
    "snapshots",
    "access",
    "lifecycle",
    "automation"
