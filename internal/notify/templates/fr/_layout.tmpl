{{/* Ce qui entoure le texte de chaque type dans un e-mail : salutation, faits, bouton, pied. */}}
{{define "text"}}Bonjour {{.User.Name}},

{{.Content}}
{{range .Facts}}
{{printf "%-14s" (print .Label " :")}} {{.Value}}{{end}}

{{.Button}} : {{.Link}}

--
{{.Portal}}. Vous recevez ce message selon vos préférences de notification : {{.Preferences}}
{{end}}
{{define "html"}}<!doctype html>
<html lang="{{.Locale}}"><head><meta charset="utf-8"><title>{{.Subject}}</title></head>
<body style="margin:0;padding:24px;background:#f6f7f9;font-family:-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;color:#1f2328;line-height:1.5">
<div style="max-width:560px;margin:0 auto 12px">{{if .LogoSrc}}<img src="{{.LogoSrc}}" alt="{{.Portal}}" height="32" style="display:block;height:32px;width:auto;border:0">{{else}}<span style="font-size:16px;font-weight:600">{{.Portal}}</span>{{end}}</div>
<div style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #d8dee4;border-radius:8px;padding:24px">
<p style="margin:0 0 12px">Bonjour {{.User.Name}},</p>
{{.ContentHTML}}
{{if .Facts}}<table style="border-collapse:collapse;margin:16px 0;font-size:14px">{{range .Facts}}
<tr><td style="padding:2px 16px 2px 0;color:#59636e">{{.Label}}</td><td>{{.Value}}</td></tr>{{end}}
</table>{{end}}
<p style="margin:20px 0 0"><a href="{{.Link}}" style="display:inline-block;background:{{.Accent}};color:{{.AccentFg}};text-decoration:none;padding:8px 14px;border-radius:6px">{{.Button}}</a></p>
</div>
<p style="max-width:560px;margin:12px auto 0;font-size:12px;color:#59636e">{{.Portal}}. Vous recevez ce message selon vos <a href="{{.Preferences}}" style="color:#59636e">préférences de notification</a>.</p>
</body></html>{{end}}
