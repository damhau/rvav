# /etc/rvav/web.env: the web app's sign-in, given to the browser.
RVAV_WEB_AUTH_MODE=oidc
# The identity provider is the API's (Administration, or RVAV_OIDC_* in
# rvav.env). These win over it in the browser, and lock their fields there.
RVAV_WEB_OIDC_AUTHORITY=
RVAV_WEB_OIDC_CLIENT_ID=
RVAV_WEB_OIDC_SCOPE=
# Origins of the VM console SDK scripts (RVAV_WMKS_SDK_URLS), for the CSP.
RVAV_WEB_SCRIPT_SOURCES=
