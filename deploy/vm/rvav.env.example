# /etc/rvav/rvav.env: rvav's settings on a VM (docs/operations/configuration.md).
# Readable by root only (chmod 600): it holds passwords and keys.
#
# The install settings only: the identity provider, vCenter, AWX,
# EfficientIP, NSX, Git, vRA and the notification channels are set in
# Administration › Integrations (ADR-0030).

RVAV_AUTH_MODE=oidc
RVAV_PUBLIC_URL=https://rvav.corp.example

RVAV_DATABASE_URL=postgres://rvav:CHANGE-ME@pg.corp.example:5432/rvav?sslmode=verify-full
RVAV_SECRETS_KEY=CHANGE-ME-32-bytes-base64
# The local administrator's first password, changed at the first sign-in
# (ADR-0030). Leave it out and the API generates one and logs it once.
# RVAV_ADMIN_PASSWORD=

RVAV_TEMPORAL_ADDRESS=temporal.corp.example:7233
RVAV_TEMPORAL_NAMESPACE=rvav
RVAV_TEMPORAL_TLS=1

# An integration's variables may still be set here: each wins over
# Administration and locks its field there.
#RVAV_VCENTER_URL=https://vc01.corp.example/sdk
#RVAV_VCENTER_USERNAME=svc-rvav@vsphere.local
#RVAV_VCENTER_PASSWORD=CHANGE-ME
# NSX's principal identity is given as files:
#RVAV_NSX_CERT_FILE=/etc/rvav/nsx.crt
#RVAV_NSX_KEY_FILE=/etc/rvav/nsx.key
