# /etc/rvav/rvav.env: rvav's settings on a VM (docs/operations/configuration.md).
# Readable by root only (chmod 600): it holds passwords and keys.

RVAV_AUTH_MODE=oidc
RVAV_PUBLIC_URL=https://rvav.corp.example
RVAV_OIDC_ISSUER=https://sso.corp.example/realms/rvav
RVAV_OIDC_CLIENT_ID=rvav

RVAV_DATABASE_URL=postgres://rvav:CHANGE-ME@pg.corp.example:5432/rvav?sslmode=verify-full
RVAV_SECRETS_KEY=CHANGE-ME-32-bytes-base64

RVAV_TEMPORAL_ADDRESS=temporal.corp.example:7233
RVAV_TEMPORAL_NAMESPACE=rvav
RVAV_TEMPORAL_TLS=1

RVAV_VCENTER_URL=https://vc01.corp.example/sdk
RVAV_VCENTER_USERNAME=svc-rvav@vsphere.local
RVAV_VCENTER_PASSWORD=CHANGE-ME
RVAV_VCENTER_NAME=vc01.corp.example

RVAV_EFFICIENTIP_URL=https://ipam.corp.example
RVAV_EFFICIENTIP_USERNAME=rvav
RVAV_EFFICIENTIP_PASSWORD=CHANGE-ME
RVAV_EFFICIENTIP_DNS_SERVER=ns1.corp.example

RVAV_AWX_URL=https://awx.corp.example
RVAV_AWX_TOKEN=CHANGE-ME
RVAV_AWX_ORGANIZATION=rvav

# The NSX Manager rvav makes networks and security groups in (ADR-0028): a
# user and password, or a principal identity's certificate and key files.
#RVAV_NSX_URL=https://nsx.corp.example
#RVAV_NSX_USERNAME=svc-rvav
#RVAV_NSX_PASSWORD=CHANGE-ME
#RVAV_NSX_CERT_FILE=/etc/rvav/nsx.crt
#RVAV_NSX_KEY_FILE=/etc/rvav/nsx.key
#RVAV_NSX_INSECURE=0

# The vRA the importer reads while projects move from it (ADR-0027): an API
# token, or a user and password in a domain. Remove once vRA is switched off.
#RVAV_VRA_URL=https://vra.corp.example
#RVAV_VRA_TOKEN=CHANGE-ME
#RVAV_VRA_USERNAME=svc-rvav-import
#RVAV_VRA_PASSWORD=CHANGE-ME
#RVAV_VRA_DOMAIN=corp.example

RVAV_SMTP_HOST=smtp.corp.example
RVAV_SMTP_FROM=rvav <rvav@corp.example>
