{
 "uid": "rvav",
 "title": "rvav",
 "tags": [
  "rvav"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "type": "stat",
   "title": "Requests running",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(rvav_requests_active{status=\"running\"})"
    }
   ],
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Waiting for approval",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(rvav_requests_active{status=\"pending_approval\"})"
    }
   ],
   "id": 2,
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "Success rate (24 h)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(rvav_requests_finished_total{outcome=\"succeeded\"}[24h])) / sum(increase(rvav_requests_finished_total{outcome=~\"succeeded|failed\"}[24h]))"
    }
   ],
   "id": 3,
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "API p95",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(rvav_http_request_duration_seconds_bucket[5m])))"
    }
   ],
   "id": 4,
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "VMs drifted",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(rvav_vms{sync_state=\"drifted\"})"
    }
   ],
   "id": 5,
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "stat",
   "title": "VMs missing",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "none",
    "graphMode": "area"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(rvav_vms{sync_state=\"missing\"})"
    }
   ],
   "id": 6,
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   }
  },
  {
   "type": "timeseries",
   "title": "API calls",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (code) (rate(rvav_http_requests_total[5m]))",
     "legendFormat": "{{code}}"
    }
   ],
   "id": 7,
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   }
  },
  {
   "type": "timeseries",
   "title": "API latency, 95th percentile, by route",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(rvav_http_request_duration_seconds_bucket[5m]))))",
     "legendFormat": "{{route}}"
    }
   ],
   "id": 8,
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   }
  },
