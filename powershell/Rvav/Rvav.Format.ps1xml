<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>Rvav.CatalogItem</Name>
      <ViewSelectedBy><TypeName>Rvav.CatalogItem</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Slug</Label></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Version</Label></TableColumnHeader>
          <TableColumnHeader><Label>Category</Label></TableColumnHeader>
          <TableColumnHeader><Label>Type</Label></TableColumnHeader>
          <TableColumnHeader><Label>Approval</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>slug</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>name</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.version.number</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>category</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>type</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>approval</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Rvav.Request</Name>
      <ViewSelectedBy><TypeName>Rvav.Request</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Number</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Title</Label></TableColumnHeader>
          <TableColumnHeader><Label>Project</Label></TableColumnHeader>
          <TableColumnHeader><Label>Environment</Label></TableColumnHeader>
          <TableColumnHeader><Label>Submitted</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>number</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>title</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.project.name</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>environment</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>submitted_at</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Rvav.Deployment</Name>
      <ViewSelectedBy><TypeName>Rvav.Deployment</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Project</Label></TableColumnHeader>
          <TableColumnHeader><Label>Environment</Label></TableColumnHeader>
          <TableColumnHeader><Label>Item</Label></TableColumnHeader>
          <TableColumnHeader><Label>Version</Label></TableColumnHeader>
          <TableColumnHeader><Label>Owner</Label></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>status</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.project.name</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>environment</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.catalog_item.name</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.version.number</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.owner.name</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>id</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Rvav.Day2Action</Name>
      <ViewSelectedBy><TypeName>Rvav.Day2Action</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Key</Label></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Resource</Label></TableColumnHeader>
          <TableColumnHeader><Label>Enabled</Label></TableColumnHeader>
          <TableColumnHeader><Label>Approval</Label></TableColumnHeader>
          <TableColumnHeader><Label>Why not</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>key</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>resource_name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>enabled</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.approval.required</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>disabled_reason</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>Rvav.Approval</Name>
      <ViewSelectedBy><TypeName>Rvav.Approval</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
          <TableColumnHeader><Label>Request</Label></TableColumnHeader>
          <TableColumnHeader><Label>Title</Label></TableColumnHeader>
          <TableColumnHeader><Label>Level</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Requester</Label></TableColumnHeader>
          <TableColumnHeader><Label>Due</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>id</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.request.number</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.request.title</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.level.name</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>status</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.requester.name</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>due_at</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
