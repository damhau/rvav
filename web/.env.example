# mock (default for `pnpm dev`) or real (default for `pnpm build`)
VITE_API_MODE=mock

# Real mode only: `oidc` (default), or `none` (alias `dev`) for an API with RVAV_AUTH_MODE=dev
VITE_AUTH_MODE=oidc
# Real mode only: the identity provider is the API's (Administration, or RVAV_OIDC_*).
# These win over it in the browser, and lock their fields in Administration.
# VITE_OIDC_AUTHORITY=https://sso.corp.example/realms/rvav
# VITE_OIDC_CLIENT_ID=rvav
# VITE_OIDC_SCOPE=openid profile email

# Mock mode only: provisioning step interval and response latency, in ms
VITE_MOCK_TICK_MS=900
VITE_MOCK_LATENCY_MS=180
