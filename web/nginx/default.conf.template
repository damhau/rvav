# Serves the built web app and proxies the API on the same origin.
# ${RVAV_API_UPSTREAM} is filled in by the nginx image at start-up.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Live events (SSE): pass each event through as soon as it is written.
    location /api/v1/events {
        proxy_pass ${RVAV_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        gzip off;
    }

    location /api/ {
        proxy_pass ${RVAV_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
    }

    # Hashed file names: safe to cache for a long time.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # Client-side routes all load index.html, which is never cached.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
