# Serves the built web app and proxies the API on the same origin.
# ${RVAV_API_UPSTREAM} is filled in by the nginx image at start-up, and
# ${NGINX_LOCAL_RESOLVERS} with the nameservers from /etc/resolv.conf.
# The identity provider's origins, where the browser fetches tokens
# (Content-Security-Policy below): the one RVAV_WEB_OIDC_AUTHORITY sets, and
# those the API says when the page is served (ADR-0030): the provider set
# in Administration, and providers being tried there.
map "${RVAV_WEB_OIDC_AUTHORITY}" $rvav_web_idp_origin {
    "~^(?<origin>https?://[^/]+)" $origin;
    default "";
}
# Only origins (scheme, host, port) separated by spaces: nothing that could
# end the directive.
map $rvav_api_idp_origins $rvav_idp_origins {
    "~^(https?://[a-zA-Z0-9.:\[\]-]+ ?)+$" $rvav_api_idp_origins;
    default "";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # The API's address is looked up at request time, not once at start-up,
    # so a recreated or rescheduled API container is found again. nginx
    # ignores search domains: on Kubernetes, RVAV_API_UPSTREAM needs the
    # service's full name (http://rvav-api.<namespace>.svc.cluster.local:8080).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $api_upstream ${RVAV_API_UPSTREAM};

    # With several API replicas (S14.1) the name has an address each: a
    # replica that is gone is given up on quickly, and an idempotent request
    # tries the next one (requests that change something have an
    # Idempotency-Key: the client may send them again).
    proxy_connect_timeout 3s;
    proxy_next_upstream error timeout http_502 http_503;

    # What the page may load (S14.6): its own files, tokens from the identity
    # provider (and its silent sign-in frame, which comes back to this
    # origin), and the VM console's SDK from RVAV_WEB_SCRIPT_SOURCES. The UI
    # libraries insert style elements. HSTS takes effect over HTTPS only.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' ${RVAV_WEB_SCRIPT_SOURCES}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' $rvav_web_idp_origin $rvav_idp_origins; frame-src 'self' $rvav_web_idp_origin $rvav_idp_origins; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Settings the web app reads at run time (S14.2): its sign-in, from the
    # container's RVAV_WEB_* environment, which wins over the API's.
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        return 200 'window.__RVAV_CONFIG__ = {"authMode": "${RVAV_WEB_AUTH_MODE}", "oidcAuthority": "${RVAV_WEB_OIDC_AUTHORITY}", "oidcClientId": "${RVAV_WEB_OIDC_CLIENT_ID}", "oidcScope": "${RVAV_WEB_OIDC_SCOPE}"};\n';
    }

    # Live events (SSE): pass each event through as soon as it is written.
    location /api/v1/events {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        gzip off;
    }

    # The VM console's WebSocket (ADR-0012), held open while it is used.
    location /api/v1/console/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # With the port, as the browser's Origin has it (rvav checks they match).
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 8h;
        gzip off;
    }

    # The vRA importer (ADR-0027): the file vra-export wrote can be large
    # (the API takes 64 MB), and reading a large vRA, or importing it,
    # takes minutes.
    location ~ ^/api/v1/admin/vra/(snapshots|import)$ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 64m;
        proxy_read_timeout 15m;
        proxy_send_timeout 15m;
    }

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
    }

    # Hashed file names: safe to cache for a long time.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # Client-side routes all load index.html.
    location / {
        try_files $uri /index.html;
    }

    # The page, never cached, with the identity provider's origins the API
    # says (ADR-0030).
    location = /index.html {
        expires -1;
        auth_request /_rvav/idp-origins;
        auth_request_set $rvav_api_idp_origins $upstream_http_x_rvav_idp_origins;
    }

    # Asks the API (GET /api/v1/auth/options); when it can't answer, the page
    # is served without them, and the local administrator can still sign in.
    location = /_rvav/idp-origins {
        internal;
        proxy_pass $api_upstream/api/v1/auth/options;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
        proxy_intercept_errors on;
        error_page 400 401 403 404 405 429 500 502 503 504 = @rvav_no_idp_origins;
    }

    location @rvav_no_idp_origins {
        return 204;
    }
}
