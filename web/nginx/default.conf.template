# Serves the built web app and proxies the API on the same origin.
# ${RVAV_API_UPSTREAM} is filled in by the nginx image at start-up, and
# ${NGINX_LOCAL_RESOLVERS} with the nameservers from /etc/resolv.conf.
# The identity provider's origin, from its issuer (RVAV_WEB_OIDC_AUTHORITY):
# the browser fetches tokens there (Content-Security-Policy below).
map "${RVAV_WEB_OIDC_AUTHORITY}" $rvav_idp_origin {
    "~^(?<origin>https?://[^/]+)" $origin;
    default "";
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # The API's address is looked up at request time, not once at start-up,
    # so a recreated or rescheduled API container is found again. nginx
    # ignores search domains: on Kubernetes, RVAV_API_UPSTREAM needs the
    # service's full name (http://rvav-api.<namespace>.svc.cluster.local:8080).
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $api_upstream ${RVAV_API_UPSTREAM};

    # With several API replicas (S14.1) the name has an address each: a
    # replica that is gone is given up on quickly, and an idempotent request
    # tries the next one (requests that change something have an
    # Idempotency-Key: the client may send them again).
    proxy_connect_timeout 3s;
    proxy_next_upstream error timeout http_502 http_503;

    # What the page may load (S14.6): its own files, tokens from the identity
    # provider (and its silent sign-in frame, which comes back to this
    # origin), and the VM console's SDK from RVAV_WEB_SCRIPT_SOURCES. The UI
    # libraries insert style elements. HSTS takes effect over HTTPS only.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' ${RVAV_WEB_SCRIPT_SOURCES}; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' $rvav_idp_origin; frame-src 'self' $rvav_idp_origin; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Settings the web app reads at run time (S14.2): its sign-in, from the
    # container's RVAV_WEB_* environment (the image's build values by default).
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        return 200 'window.__RVAV_CONFIG__ = {"authMode": "${RVAV_WEB_AUTH_MODE}", "oidcAuthority": "${RVAV_WEB_OIDC_AUTHORITY}", "oidcClientId": "${RVAV_WEB_OIDC_CLIENT_ID}", "oidcScope": "${RVAV_WEB_OIDC_SCOPE}"};\n';
    }

    # Live events (SSE): pass each event through as soon as it is written.
    location /api/v1/events {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        gzip off;
    }

    # The VM console's WebSocket (ADR-0012), held open while it is used.
    location /api/v1/console/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # With the port, as the browser's Origin has it (rvav checks they match).
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 8h;
        gzip off;
    }

    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
    }

    # Hashed file names: safe to cache for a long time.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # Client-side routes all load index.html, which is never cached.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}
