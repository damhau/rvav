# rvav configuration. Every process reads the same variables; unused ones
# are ignored. Copy to .env for docker compose, or export them in a shell.

# HTTP
RVAV_HTTP_ADDR=:8080
RVAV_LOG_LEVEL=info
# Origins allowed to call the API from a browser (the Vite dev server).
RVAV_CORS_ORIGINS=http://localhost:5173

# Database
RVAV_DATABASE_URL=postgres://rvav:rvav@localhost:5432/rvav?sslmode=disable

# Authentication: oidc (default) or dev.
# dev trusts every request as a seeded user (lmartin by default; switch
# with the X-Rvav-Dev-User header). Never use it outside a developer machine.
RVAV_AUTH_MODE=dev
# Dev mode refuses to start without this.
RVAV_ALLOW_DEV_AUTH=1
RVAV_DEV_USER=lmartin
RVAV_OIDC_ISSUER=http://localhost:8081/realms/rvav
# Only when the API reaches the provider at another URL than the issuer.
RVAV_OIDC_DISCOVERY_URL=
RVAV_OIDC_CLIENT_ID=rvav
RVAV_OIDC_GROUPS_CLAIM=groups

# Temporal
RVAV_TEMPORAL_ADDRESS=localhost:7233
RVAV_TEMPORAL_NAMESPACE=default
RVAV_TEMPORAL_TASK_QUEUE=rvav-provision

# vCenter (worker and sync). For vcsim: make vcsim, then the values it prints.
RVAV_VCENTER_URL=https://127.0.0.1:8989/sdk
RVAV_VCENTER_USERNAME=user
RVAV_VCENTER_PASSWORD=pass
RVAV_VCENTER_INSECURE=1
RVAV_VCENTER_NAME=vc01.corp.example
RVAV_SYNC_INTERVAL=20s

# EfficientIP SOLIDserver, or a fake SOLIDserver run in this process.
RVAV_FAKE_EFFICIENTIP=1
RVAV_EFFICIENTIP_URL=
# native (X-IPM headers), basic, or token (username = key ID, password = secret).
RVAV_EFFICIENTIP_AUTH=native
RVAV_EFFICIENTIP_USERNAME=
RVAV_EFFICIENTIP_PASSWORD=
RVAV_EFFICIENTIP_INSECURE=0
# The IPAM space subnets are looked up in, when a CIDR exists in several.
RVAV_EFFICIENTIP_SPACE=
# The DNS server (or smart architecture) and view records are created on.
RVAV_EFFICIENTIP_DNS_SERVER=
RVAV_EFFICIENTIP_DNS_VIEW=
# How often the sync service links vSphere networks to subnets from their
# class parameters (vsphere_network, gateway, domain, dns_servers).
RVAV_IPAM_SYNC_INTERVAL=5m

# AWX, or the fake that plays jobs like linux-baseline and idm-join.
RVAV_FAKE_AWX=1
RVAV_AWX_URL=
RVAV_AWX_TOKEN=
# Templates are looked up in this organisation (all of them when empty).
RVAV_AWX_ORGANIZATION=
# The sync service imports the organisation's templates with any of these
# labels into the catalog, every RVAV_AWX_SYNC_INTERVAL.
RVAV_AWX_CATALOG_LABELS=catalog
# Templates with one of these labels become day-2 actions (ADR-0018).
RVAV_AWX_ACTION_LABELS=day2
RVAV_AWX_SYNC_INTERVAL=5m
RVAV_AWX_INSECURE=0
# rvav's inventory source (ADR-0017): refreshed before jobs on rvav's VMs, which
# are launched on its inventory.
RVAV_AWX_INVENTORY_SOURCE_ID=0
# Fake only: time per task, and a task that fails (to see the error path).
RVAV_FAKE_AWX_TASK_DELAY=1500ms
RVAV_FAKE_AWX_FAIL_TASK=

# Stored secrets (value sources' credentials, connection passwords and tokens
# set from the UI) are encrypted with this key: 32 bytes in base64 (openssl
# rand -base64 32). Keep it out of the database.
RVAV_SECRETS_KEY=
# To rotate it: set the new key above, list the old one here (comma-separated),
# restart, run `rvav secrets rotate`, then empty this.
RVAV_SECRETS_OLD_KEYS=
# Written on everything rvav creates in EfficientIP, so two rvav instances
# sharing a SOLIDserver don't report each other's objects as orphans.
RVAV_INSTANCE_ID=rvav
# Hosts `rest` value sources may call, over https: cmdb.corp.example,
# *.corp.example, host:8443. http://host[:port] also allows plain http to that
# host (a development stand-in: a secret would travel in clear). Inputs fill a
# source's path and query only, never its host.
RVAV_REST_SOURCE_HOSTS=
# Hosts event subscriptions may post webhooks to (ADR-0021), as for REST
# sources: https by default, http://host for a development stand-in. Empty:
# no webhooks.
RVAV_WEBHOOK_HOSTS=
